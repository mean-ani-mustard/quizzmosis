<%--
    Navigation bar shared by all pages. The including page sets ${activeNav} to highlight its link.
    ${inboxBadge} (unread messages + open friend requests + challenges waiting for an answer) is set by AuthFilter.
--%>
<nav class="navbar navbar-expand-xl navbar-dark glass-card mx-3 mt-3 px-3">
    <a class="navbar-brand fw-bold" href="${ctx}/home">Quizz<span class="text-warning">mosis</span></a>
    <c:if test="${not empty sessionScope.user}">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'home' ? 'active' : ''}" href="${ctx}/home">
                        <i class="bi bi-house-door-fill"></i> Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'quizzes' ? 'active' : ''}" href="${ctx}/quizzes">
                        <i class="bi bi-list-check"></i> Quizzes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'create' ? 'active' : ''}" href="${ctx}/quiz/create">
                        <i class="bi bi-plus-circle"></i> Create Quiz</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'leaderboard' ? 'active' : ''}" href="${ctx}/leaderboard">
                        <i class="bi bi-trophy-fill"></i> Leaderboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'friends' ? 'active' : ''}" href="${ctx}/friends">
                        <i class="bi bi-people-fill"></i> Friends</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${activeNav == 'messages' ? 'active' : ''}" href="${ctx}/messages">
                        <i class="bi bi-envelope-fill"></i> Messages
                        <%-- app.js refreshes this number every 30 seconds from the address in data-inbox-badge. --%>
                        <span class="badge rounded-pill bg-danger" data-inbox-badge="${ctx}/messages/count"
                              ${inboxBadge > 0 ? '' : 'hidden'}>${inboxBadge}</span>
                    </a>
                </li>
                <c:if test="${sessionScope.user.admin}">
                    <li class="nav-item">
                        <a class="nav-link ${activeNav == 'admin' ? 'active' : ''}" href="${ctx}/admin">
                            <i class="bi bi-shield-fill"></i> Admin</a>
                    </li>
                </c:if>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle ${activeNav == 'profile' or activeNav == 'history' or activeNav == 'achievements' or activeNav == 'settings' ? 'active' : ''}"
                       href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <q:avatar name="${sessionScope.user.displayName}" userId="${sessionScope.user.userId}"/>
                        <c:out value="${sessionScope.user.displayName}"/>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="${ctx}/profile"><i class="bi bi-person"></i> My profile</a></li>
                        <li><a class="dropdown-item" href="${ctx}/history"><i class="bi bi-clock-history"></i> Quiz history</a></li>
                        <li><a class="dropdown-item" href="${ctx}/achievements"><i class="bi bi-award"></i> Achievements</a></li>
                        <li><a class="dropdown-item" href="${ctx}/settings"><i class="bi bi-gear"></i> Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <%-- Logging out changes state, so it's a POST form with the CSRF token. --%>
                            <form method="post" action="${ctx}/logout" class="m-0">
                                <input type="hidden" name="_csrf" value="${csrfToken}">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Log out</button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </c:if>
</nav>
