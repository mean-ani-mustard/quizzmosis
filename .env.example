# Settings for docker-compose.yml. Copy this file to .env and change the values;
# .env is listed in .gitignore, so your passwords stay on your computer.

# Password of MySQL's root user (also used by the integration tests, see README).
MYSQL_ROOT_PASSWORD=root

# Password of the "quizzmosis" database user that the web app logs in with.
DB_PASSWORD=quizzmosis

# Ports on your computer: the website and the MySQL server.
APP_PORT=8080
DB_PORT=3306
